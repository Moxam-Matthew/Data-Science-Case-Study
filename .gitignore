# Data is NOT committed. The loader in src/support2.py reads a local copy if
# one is present and otherwise fetches from UCI.
# This is deliberate rather than incidental: most clinical data use agreements
# prohibit redistributing row-level records, so the project is built to that
# standard from the first commit instead of being retrofitted later.
data/
*.csv
*.zip

.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
.claude/

# Build artefacts from `pip install -e .`
*.egg-info/
build/
dist/
